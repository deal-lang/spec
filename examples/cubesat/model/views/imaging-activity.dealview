/*
 * Imaging-pass activity view (viewer P4 — behavior/flow). Renders the
 * ImagingPassActivity: action steps as rounded boxes, the SysML v2 control
 * nodes (start, decision/merge, fork/join, done), control flow as successions,
 * and the typed `~>` item flow as an object-flow edge. Source is the FRONTIER
 * packages/behaviors/activities.deal — deal-ids resolve once the BH action/flow
 * grammar lands.
 */
view {
    title: "HALCYON — Imaging Pass (Activity)";
    viewpoint: activity;
    direction: left-to-right;
    dangling-edges: stub;
}

include {
    behaviors.activities.ImagingPassActivity.**;
}

[deal-id="behaviors.activities.ImagingPassActivity.acquireState"] { x: 60;  y: 200; w: 150; h: 70; }
[deal-id="behaviors.activities.ImagingPassActivity.slewToTarget"] { x: 360; y: 120; w: 150; h: 70; }
[deal-id="behaviors.activities.ImagingPassActivity.warmUpImager"] { x: 360; y: 280; w: 150; h: 70; }
[deal-id="behaviors.activities.ImagingPassActivity.captureScene"] { x: 600; y: 200; w: 150; h: 70; }
[deal-id="behaviors.activities.ImagingPassActivity.storeProduct"] { x: 840; y: 200; w: 150; h: 70; }

// Object flow (frame ~> data) drawn distinctly from control successions.
[deal-connect="captureScene.frame -> storeProduct.data"] {
    line-style: dashed;
    arrowhead: open;
}
