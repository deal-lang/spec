@header {
    path:       model/views/power-ibd.dealview
    schema:     dealview/0.1
    created:    2026-06-14T00:00:00Z by "David Dunnock" via claude:cowork
    modified:   2026-06-14T00:00:00Z by "David Dunnock" via claude:cowork
    hash:       sha256:pending
    status:     draft
    marking:    Unclassified
}

/*
 * Power Internal Block Diagram — the EPS interconnect. Exercises:
 *   - 3+ nesting levels (system -> EnergyStorage -> pdu -> rail ports),
 *     cross-container orthogonal routing with the no-cross guarantee (INV-1)
 *   - same-source bundling (RG-10.9): the PDU's five switched rails fan out
 *     to four subsystem loads from one source, merging into a shared trunk
 *   - port flow glyphs on all four faces (RG-9.9): in-rails West, out-rails East
 */
view {
    title: "HALCYON — Power Distribution (IBD)";
    viewpoint: interface;
    direction: left-to-right;
    edge-labels: carrying;
}

include {
    model.Halcyon.EnergyStorage.**;
    model.Halcyon.ADCS.powerIn;
    model.Halcyon.Comms;
    model.Halcyon.Payload;
    model.Halcyon.Thermal.heaters;
}

[deal-id="model.Halcyon.EnergyStorage"] {
    x: 40; y: 40; w: 420; h: 520;
}
[deal-id="model.Halcyon.EnergyStorage.pdu"] {
    x: 220; y: 200; w: 160; h: 280;
}
[deal-id="model.Halcyon.EnergyStorage.battery"] {
    x: 30; y: 60; w: 150; h: 120;
}

// All five PDU rails are PowerFlow — colored from the theme; the four that
// leave the container route as a bundled trunk to the loads.
connect[carrying="PowerFlow"] {
    stroke: power;
    stroke-width: 2.5;
    routing: orthogonal;
}

[deal-connect="EnergyStorage.railADCS -> ADCS.powerIn"] {
    waypoints: (460, 300) (520, 300);
}
[deal-connect="EnergyStorage.railPayload -> Payload"] {
    waypoints: (460, 340) (520, 340) (520, 200);
}
