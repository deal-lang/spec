/*
 * HALCYON spacecraft bus — part definitions for all subsystems.
 *
 * NOTE: block comment, not doc comment — DealFile ::= HeaderBlock?
 * PackageDeclaration … permits no doc comment between @header and
 * `package` (doc comments attach to definitions only).
 *
 * KerML mapping: a DEAL `package` normalizes directly (M1) to KerML Package
 * (8.3.4.13.4); the sysml-v2 emitter folds the workspace into a single
 * top-level Package today (D-24), with nested packages as owned members.
 * The `@header` block above is a configuration-management envelope and is
 * deliberately model-silent (FS-2) — it never reaches the KerML graph.
 */
package spacecraft;

