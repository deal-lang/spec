/*
 * Shared interface vocabulary: power, data, RF, and thermal ports and
 * interface definitions used across the HALCYON bus.
 */
package interfaces;

export power.{PowerTelemetry, UnregulatedBusPort, SwitchedRailPort, Rail3V3, Rail5V, Rail12V, ArrayInputPort, UmbilicalPort};
export data.{CANPort, CANBus, SpaceWirePort, SpaceWireLink, TelemetryFrames, CommandPackets, ImageData};
export rf.{UHFPort, XBandPort, RFCoaxLink};
export thermal.{ConductiveStrapPort, HeaterCircuitPort, ThermallyManaged};
export harnesses.{PowerHarness, DataHarness, PowerFlow};
