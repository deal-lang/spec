package vehicle.behaviors;

import deal.std.units.{Dimensionless, Temperature};

// State-machine surface per BH-4/BH-7. A transition collapses KerML
// trigger/guard/effect/target onto one line: `on TRIGGER [GUARD] / EFFECT -> TARGET`.
// State behaviors use `entry|do|exit / BEHAVIOR`.

/**
 * Charging control state machine.
 * Exercises: state def + StateBody, state parameters (pins), initial/final
 * succession wiring, nested state usages, entry/do/exit behaviors, triggered
 * transitions (with and without guard/effect), and `done` as a final target.
 */
state def ChargingControl {
    in soc  : Dimensionless;
    in temp : Temperature;

    start -> Idle;

    state Idle {
        on PlugInserted -> Charging;
    }

    state Charging {
        entry / startCharge();
        do    / regulateCurrent();
        exit  / stopCharge();

        on PlugRemoved -> Idle;
        on socFull  [soc >= 100] / notify()   -> Idle;
        on tempHigh [temp > 60]  / shutdown() -> Fault;
    }

    state Fault {
        on reset -> Idle;
    }

    Fault -> done;
}
